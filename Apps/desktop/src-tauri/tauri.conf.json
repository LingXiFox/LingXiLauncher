{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LingXi Launcher",
  "version": "0.10.0",
  "identifier": "com.lingxifox.LingXiLauncher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LingXi Launcher",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://textures.minecraft.net https://cdn.modrinth.com data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "A native Minecraft launcher",
    "longDescription": "LingXi Launcher: instances, Microsoft sign-in, Fabric and NeoForge, mods and performance tuning."
  }
}
